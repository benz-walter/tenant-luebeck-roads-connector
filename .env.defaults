# Enable debug mode to get more information about exceptions etc.
# Default: False
DEBUG=True

# Logging level. Any messages above this log level will be included in stderr.
# Do not use DEBUG in production environments, as this can leak sensitive information
# Default:
#   INFO (if DEBUG=False)
#   DEBUG (if DEBUG=True)
# LOG_LEVEL=INFO

####
#### Synchronisation configuration.
####
# List of tables to sync, separated by comma, e.g. "table_1, table_2, ..."
# Required
# SYNC_TABLES=""

# Interval the synchronization should take place, in minutes.
# Minimum is one (1) minute to reduce the likelihood of a DDOS.
# Default: 30
# SYNC_INTERVAL_MINUTES=30


####
#### Database configuration.
####
# Database URL to connect to, including the dialect of the database.
# The password needs to be URL-encoded to be interpreted correctly.
# Examples:
#   postgresql://my-user:my-password@postgres.example.com:5432/dbname
#   mysql+mysqldb://my-user:my-password@mysql.example.com/dbname
# Required
DATABASE_URL=postgresql://postgres:this.key.is.unsecure.and.should.be.only.used.in.development.Ahsh1shuchue@database:5432/postgres

####
#### RabbitMQ configuration.
####

# Host of the RabbitMQ server
# Default: localhost
RABBITMQ_HOST=rabbitmq

# Port to use for the RabbitMQ connection
# Default: 5672
# RABBITMQ_PORT=5672

# Queue name to push the database data into.
# Required
RABBITMQ_QUEUE_NAME=roads
